# ============================================
# QAU Sentinel — System Dashboard Client (.env)
# ============================================
# Copy this file to `.env` and fill in your real values.
# The `.env` file is git-ignored and will NOT be uploaded to GitHub.
# Never commit real credentials.

# --- Dashboard connection ---
# IP/hostname of the machine running the Sentinel Flask backend.
DASHBOARD_IP=127.0.0.1

# Port of the Sentinel Flask backend.
DASHBOARD_PORT=5000

# --- Dashboard login credentials ---
# These must match a user created in the backend (see seed_users.py).
DASHBOARD_EMAIL=admin@qau.edu.pk
DASHBOARD_PASSWORD=admin123

# --- Camera metadata ---
# Optional: override the camera id and location reported to the dashboard.
# CAMERA_ID=1
# CAMERA_LOCATION=Main Entrance
